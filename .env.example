# v2 では生成/収集を Cloudflare 側に寄せたので、Python 用の env は最小。
# 各種 API キーは下記のとおり Cloudflare 側で管理する:
#   - QIITA_TOKEN: wrangler secret put QIITA_TOKEN  (crawler/ ディレクトリで)
#   - CF_API_TOKEN: wrangler login or wrangler config 経由

# 分析スクリプトが D1 export 先を override したい場合のみ設定:
CORPUS_DB_PATH=data/d1_export/corpus.sqlite
